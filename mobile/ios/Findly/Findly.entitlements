<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FCM/APNs push (specs/001 §8). "development" until a distribution build; Xcode manages this
	     automatically per build configuration once the project exists. -->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  PENDING (specs/000 §O1, specs/004 §7) — a human/Apple-account action, not blocking I1/I2:
	  <key>com.apple.developer.location.push</key>
	  <true/>
	  Add this only once Apple grants the entitlement (Apple Developer Program enrollment required
	  first). Adding it before the entitlement is granted breaks code signing.
	-->
	<!-- Associated Domains for public join links (https://{JOIN_LINK_HOST}/g#CODE) — activated
	     2026-07-25 (H6): Apple Developer enrollment complete, Team ID 92A2K3Q7NH. Before a real
	     signed build, enable the "Associated Domains" capability on the com.findly.ios App ID +
	     provisioning profile (the Xcode app target doesn't exist yet — specs/004 §1.1). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
	  <string>applinks:kind-plant-0fb99b003.7.azurestaticapps.net</string>
	</array>
</dict>
</plist>
