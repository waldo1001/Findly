<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- I9 (specs/004 §1.1): required for any installable bundle, not business logic — this file
	     predates a real Xcode project (I1-era, only ever validated via `swiftc -typecheck`), so
	     the standard Xcode-template keys that make a real .app bundle installable were never
	     added. Without these two, `xcodebuild build` still succeeds (it doesn't validate runtime
	     bundle keys) but `simctl install`/a real device install fails with "Missing bundle ID".
	     Values are the standard Xcode-template build-setting substitutions, not hardcoded. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleDisplayName</key>
	<string>Findly</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Staged When-In-Use -> Always authorization (000 §O1's onboarding dance): request
	     When-In-Use first, then an explicit in-app upgrade prompt before requesting Always. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Findly shows your family members' locations on a shared map. Your device's location is shared with your family while the app is open.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Findly periodically shares your location with your family in the background, on the interval you choose in Settings, so everyone can see where everyone is even when the app isn't open.</string>
	<!-- content-available background pushes (LOCATE_REQUEST / SETTINGS_CHANGED / GEOFENCE_CONFIG_CHANGED,
	     specs/001 §8) + significant-change location monitoring (specs/004 §7). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- specs/009-device-runtime.md §3.4 (I10) — the opportunistic BGAppRefreshTask identifier.
	     BGTaskScheduler.submit() throws BGTaskSchedulerError.notPermitted for any identifier
	     missing from this array, even after a successful register(forTaskWithIdentifier:...) call. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>be.dynex.findly.refresh</string>
	</array>
	<!-- specs/004-ios-client.md §3.4/§3.5, specs/005-temporary-groups.md §5 — the group-join deep
	     link (findly://group-join?code=…), forwarded via onOpenURL to
	     AppCoordinator.handleDeepLink. HTTPS universal links (specs/007-public-join-links.md,
	     https://{JOIN_LINK_HOST}/g#CODE) are handled by the SAME onOpenURL/handleDeepLink path via
	     the Associated Domains entitlement below (prepared, not yet active — see
	     Findly.entitlements) rather than a CFBundleURLTypes scheme; no change needed here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>findly</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
