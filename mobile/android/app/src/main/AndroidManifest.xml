<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (specs/003-android-client.md §11; 000-overview.md §O2). The runtime staged
         FINE -> BACKGROUND request flow is implemented in A2; declared here now so the manifest
         does not need to change when that lands. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service for 5/10-minute sync intervals (000-overview.md §O2). Service
         implementation is A2; declared now for the same reason as above. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Geofence / locate / settings push notifications (001-api-contract.md §8) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FindlyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Findly">

        <!-- A12 (specs/003-android-client.md §12): the Google Maps SDK reads its API key from
             this meta-data tag at process start (GoogleMapRenderer's only key touch-point — it
             never reads AppConfig.mapsApiKey directly). ${mapsApiKey} is a Gradle manifest
             placeholder sourced from the same MAPS_API_KEY project property as
             BuildConfig.MAPS_API_KEY (app/build.gradle.kts), so the two can never drift apart.
             Empty by default until H1 provisions a real key (docs/azure-setup.md) — the map still
             builds and runs with an empty value, it simply renders a tile-less grey surface (same
             "degrade gracefully without secrets" pattern as every other H1-waived dependency
             here); never hardcoded, never committed (docs/security-review-checklist.md §5). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Findly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A5 (specs/005-temporary-groups.md, specs/003-android-client.md §12.2): the
                 app's first and only external deep link, findly://group-join?code=XXXXXXXX. A
                 custom scheme (not an android:autoVerify https App Link), so no digital-asset-
                 links verification is needed; the `code` query param is untrusted input and is
                 sanitized in FindlyNavHost/GroupJoinCodeSanitizer before any network call. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="findly" android:host="group-join" />
            </intent-filter>

            <!-- A6 (specs/007-public-join-links.md, specs/003-android-client.md §12.3): the
                 public https://{JOIN_LINK_HOST}/g#CODE join link (App Links — android:autoVerify
                 triggers OS verification against the host's /.well-known/assetlinks.json, 007
                 §3, using the same SHA-256 signing fingerprints as the Firebase/App Check
                 registration). ${joinLinkHost} is a Gradle manifest placeholder sourced from the
                 same JOIN_LINK_HOST build-config value (app/build.gradle.kts) so the two can
                 never drift apart. Unlike the findly:// filter above, the join code lives in the
                 URL FRAGMENT (007 §1) — irrelevant to this intent-filter's own host/path matching
                 (and, unlike the findly:// filter's `code` query param, never delivered to a
                 server/CDN/proxy at all) — so it is read directly off the delivered Uri and
                 sanitized in MainActivity/FindlyNavHost via GroupJoinHttpsLinkParser, the same
                 whitelist gate as the filter above. A wrong host or path is ignored, never
                 mis-routed (007 §4); the findly:// filter above remains supported unchanged (007
                 §1: backward compatibility). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${joinLinkHost}"
                    android:path="/g" />
            </intent-filter>

            <!-- A36 (specs/007-public-join-links.md §1/§4 as amended 2026-08-26, specs/003-
                 android-client.md §12.3/§12.2 mirror, specs/010 §5.2): the family-invite twin of
                 the two group filters above, `findly://family-join?code=XXXXXXXX` — a custom
                 scheme (not android:autoVerify), so no digital-asset-links verification is
                 needed; the `code` query param is untrusted input, sanitized in
                 FindlyNavHost/FamilyInviteCodeSanitizer before any network call, exactly like
                 group-join's `code` param above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="findly" android:host="family-join" />
            </intent-filter>

            <!-- A36 (specs/007-public-join-links.md §1/§4 as amended 2026-08-26, specs/003-
                 android-client.md §12.3/§12.2 mirror, specs/010 §5.2): the family-invite twin of
                 the https /g App Link above, path /f instead. Same ${joinLinkHost} placeholder
                 (one JOIN_LINK_HOST build-config value serves both /g and /f, 007 §1), same
                 android:autoVerify (App Links verification against the shared assetlinks.json,
                 007 §3). Unlike the findly:// filter above, the invite code lives in the URL
                 FRAGMENT (007 §1), never delivered to a server/CDN/proxy at all, so it is
                 read directly off the delivered Uri and sanitized in
                 MainActivity/FindlyNavHost via FamilyInviteHttpsLinkParser, the same whitelist
                 gate as the https /g filter above. A wrong host or path is ignored, never
                 mis-routed (007 §4); /f never routes to the group-join screen, nor /g to this
                 one. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${joinLinkHost}"
                    android:path="/f" />
            </intent-filter>
        </activity>

        <!-- A9 (specs/003-android-client.md §9; specs/009-device-runtime.md §5): the real FCM
             entry point. android:exported="false" — only the FCM SDK itself (via the
             com.google.firebase.MESSAGING_EVENT intent) ever binds to this; no other app may. -->
        <service
            android:name=".push.FindlyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- A10 (specs/009-device-runtime.md §3.2): the 5/10-minute foreground service.
             android:foregroundServiceType="location" is required alongside the
             FOREGROUND_SERVICE_LOCATION permission above (Android 14+ hard-enforces the type
             declaration matching the permission). Never started/stopped except through
             ForegroundServiceController -> not exported. -->
        <service
            android:name=".queue.worker.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- A11 (specs/009-device-runtime.md §6.3): GeofencingClient's transition callback
             target. Fired only via the PendingIntent GeofencingClientManager registers with every
             addGeofences call (AppContainer) - exported="false" is safe because delivery goes
             through that PendingIntent's own identity, never a raw external broadcast. -->
        <receiver
            android:name=".location.geofence.GeofenceTransitionReceiver"
            android:exported="false" />

        <!-- specs/003-android-client.md §12.4 / 001-api-contract.md §13.1: the export share-sheet
             handoff needs a content:// URI for the downloaded file (ExportFileWriter.kt). Only
             cacheDir/exports/ is exposed (res/xml/file_paths.xml) — nothing else in the app's
             storage is reachable through this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- A15 (docs/store-readiness.md §1; androidx.work's RemoveWorkManagerInitializer lint
             check): FindlyApplication implements Configuration.Provider so WorkManager should use
             AppContainer.workerFactory instead of its default no-arg-constructor factory — but
             that alone is not sufficient while this entry stays merged in. Verified from the
             actual androidx.work:2.10.0 bytecode: WorkManagerInitializer.create() (run by this
             InitializationProvider's ContentProvider.onCreate(), which the platform invokes
             *before* Application.onCreate()) unconditionally calls
             WorkManager.initialize(context, Configuration.Builder().build()) — no check for
             Configuration.Provider anywhere in that class. That first call wins the WorkManagerImpl
             singleton with the *default* WorkerFactory; WorkManagerImpl.getInstance(Context) only
             ever consults Configuration.Provider when no instance exists yet, so every later call
             from AppContainer silently gets the already-default-configured instance back —
             FindlyApplication's workManagerConfiguration is never read, and
             LocationSyncWorker/SettingsPollWorker (whose constructors need the extra dependency
             parameters only FindlyWorkerFactory supplies, specs/009-device-runtime.md §3, A10's
             durable location-fix sync) fail to construct at runtime. Removing just this stock
             manifest entry (on-demand init itself stays code-only, androidx.work's documented
             pattern) is what actually makes Configuration.Provider take effect — not merely a
             lint-satisfying change. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
