<!-- See backup_rules.xml (A62: the pending join/invite link, A63: the per-install app-lock setting - both excluded from both paths) — revisit at H1. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="findly_pending_link.xml"/>
        <exclude domain="sharedpref" path="findly_app_lock.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="findly_pending_link.xml"/>
        <exclude domain="sharedpref" path="findly_app_lock.xml"/>
    </device-transfer>
</data-extraction-rules>
