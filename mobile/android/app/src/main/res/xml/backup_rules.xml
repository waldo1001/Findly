<?xml version="1.0" encoding="utf-8"?>
<!--
  A62: the pending join/invite link (a 1 h capability code, specs/010 section 1.3) is the one
  thing excluded: it must never enter a backup. Everything else persists nothing sensitive
  (the DeviceIdStore is a per-uid UUID, not a credential). Revisit once real Firebase Auth / FCM
  tokens are cached locally at H1.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="findly_pending_link.xml"/>
    <exclude domain="sharedpref" path="findly_app_lock.xml"/>
</full-backup-content>
