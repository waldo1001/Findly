{
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "frame-ancestors 'none'"
  },
  "routes": [
    {
      "route": "/g",
      "rewrite": "/index.html"
    },
    {
      "route": "/f",
      "rewrite": "/family.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/delete-account",
      "rewrite": "/delete-account.html"
    },
    {
      "route": "/.well-known/apple-app-site-association",
      "rewrite": "/.well-known/apple-app-site-association.json"
    },
    {
      "route": "/.well-known/assetlinks.json",
      "headers": {
        "Content-Type": "application/json"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.well-known/*"]
  }
}
